[Unit]
Description=Hangman Web Application
After=network.target

[Service]
Type=simple
User=melomario
WorkingDirectory=/Users/melomario/projects/hangman-web
Environment="NODE_ENV=production"
Environment="PORT=5173"
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
